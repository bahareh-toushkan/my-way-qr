# Google AI Studio에서 만든 키 (Vercel 환경변수에 넣기, 저장소에 올리지 않기)
GEMINI_API_KEY=
# 선택: 사용할 모델 (기본 gemini-2.5-flash, 안 되면 gemini-2.5-flash-lite로 자동 전환)
GEMINI_MODEL=
# 선택: 'mock'이면 AI 대신 로컬 테스트용 가짜 변환기 사용 (측정값을 보고서에 쓰면 안 됨)
AI_PROVIDER=
# 선택: 하루 AI 호출 상한 (기본 300). 넘으면 규칙 기반 화면으로 대체
AI_DAILY_LIMIT=
# 선택: /eval 페이지와 사용자 테스트 기록 조회용 암호
EVAL_KEY=
# Vercel에서 Upstash Redis를 연결하면 자동으로 들어오는 값 (둘 중 한 쌍)
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
